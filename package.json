{
  "name": "andriansyahnc-blog",
  "version": "2.2.0",
  "private": true,
  "scripts": {
    "start": "next dev",
    "dev": "cross-env INIT_CWD=$PWD next dev",
    "build": "contentlayer2 build && next build && cross-env NODE_OPTIONS='--experimental-json-modules' node ./scripts/postbuild.mjs",
    "serve": "next start",
    "analyze": "cross-env ANALYZE=true next build",
    "lint": "eslint --fix .",
    "optimize-images": "node ./scripts/optimize-images.mjs",
    "prepare": "husky || true",
    "test": "vitest run"
  },
  "dependencies": {
    "@headlessui/react": "1.7.19",
    "@next/bundle-analyzer": "16.4.3",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@vercel/speed-insights": "^1.2.0",
    "autoprefixer": "^10.6.2",
    "axios": "^1.21.0",
    "contentlayer2": "0.5.8",
    "esbuild": "0.25.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "hast-util-from-html-isomorphic": "^2.0.0",
    "katex": "^0.16.22",
    "kbar": "0.1.0-beta.45",
    "luxon": "^3.5.0",
    "next": "16.4.3",
    "next-contentlayer2": "0.5.8",
    "next-themes": "^0.3.0",
    "pliny": "0.2.0",
    "postcss": "^8.5.32",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-icons": "^5.5.0",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-citation": "^2.3.1",
    "rehype-katex": "^7.0.1",
    "rehype-preset-minify": "7.0.0",
    "rehype-prism-plus": "^2.0.1",
    "rehype-slug": "^6.0.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^3.4.17",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@types/luxon": "^3.7.1",
    "@types/mdx": "^2.0.13",
    "@types/node": "25.0.3",
    "@types/react": "^18.3.23",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "js-yaml": "3.14.2",
    "lint-staged": "^13.3.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "sharp": "^0.34.5",
    "sharp-cli": "^5.2.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx)": [
      "eslint --fix"
    ],
    "*.+(js|jsx|ts|tsx|json|css|md|mdx)": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=24.x"
  },
  "pnpm": {
    "overrides": {
      "@grpc/grpc-js@1": "^1.13.6",
      "@opentelemetry/propagator-jaeger": "^2.9.0",
      "brace-expansion@1": "^1.1.20",
      "brace-expansion@2": "^2.1.6",
      "follow-redirects": "^1.16.1",
      "form-data@2": "^2.5.6",
      "form-data@4": "^4.0.6",
      "js-yaml@3": "^3.15.2",
      "js-yaml@4": "^4.3.2",
      "minimatch@3": "^3.1.4",
      "minimatch@9": "^9.0.7",
      "nanoid@3": "^3.3.18",
      "picomatch@2": "^2.3.2",
      "probe-image-size": "^7.4.0",
      "source-map-js": "^1.2.2",
      "toml@4": "^4.2.0",
      "toml@5": "^5.0.1",
      "ws@7": "^7.5.11",
      "zod@4": "^4.6.6",
      "browserslist": "^4.28.7"
    }
  }
}
